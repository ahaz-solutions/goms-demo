# ── Django Backend (set these in Railway environment variables) ──────────────

# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-strong-secret-key-here

# Set to False in production
DEBUG=False

# Your Railway domain e.g. goms-backend.up.railway.app
ALLOWED_HOSTS=goms-backend.up.railway.app

# Provided automatically by Railway when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Your Vercel frontend URL (no trailing slash)
CORS_ALLOWED_ORIGINS=https://goms.vercel.app

# ── AWS S3 for media files (glass images, payment proofs) ────────────────────
# Skip for initial deploy — set USE_S3=False to use local storage (not recommended for production)
USE_S3=True
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=goms-media
AWS_S3_REGION_NAME=us-east-1
